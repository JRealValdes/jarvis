# Secrets (required for real LLM / API use)
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
FERNET_KEY=PASTE_YOUR_FERNET_KEY_HERE
JWT_SECRET_KEY=PASTE_YOUR_JWT_SECRET_KEY_HERE

# App settings (defaults match jarvis.core.config when unset)
API_PORT=8000
JWT_ALGORITHM=HS256
JWT_EXP_DELTA_SECONDS=3600
JARVIS_DEFAULT_MODEL=GPT_4O_MINI
JARVIS_LOCAL_THREAD_ID=1
JARVIS_IDENTIFICATION_FAILED_PROTOCOL=AUTOMATIC_RESPONSE
JARVIS_DB_DEBUG_MODE=0
JARVIS_USE_MCP=0
# Include tool call/result lines in chat UI/API history (default: final replies only)
JARVIS_SHOW_TOOL_TRACES=0
# Score image-search hits (title, size, Wikimedia) before the top results. Off keeps the simpler first-hits path.
JARVIS_RANKED_IMAGE_RETRIEVAL=0
# One GPT-4o mini vision look per turn at the best web image. Off skips the check (faster, no extra vision call).
JARVIS_VISION_VERIFY_IMAGES=0
# Save assistant images under data/images and embed a Jarvis URL. Off keeps the remote hotlink.
JARVIS_IMAGE_STORAGE=1
# Retention in days. 0 means never auto-delete. Web search vs later generated images.
JARVIS_WEB_IMAGE_TTL_DAYS=30
JARVIS_GENERATED_IMAGE_TTL_DAYS=365
# Origin phones and Gradio use to fetch stored images (no path). Unset embeds /images/{id}.
# JARVIS_PUBLIC_BASE_URL=http://jarvis.example:8000

# LangSmith tracing (optional; inspect agent/tool runs without chat verbosity)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=PASTE_YOUR_LANGSMITH_API_KEY_HERE
# LANGSMITH_PROJECT=jarvis
