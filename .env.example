# Secrets (required for real LLM / API use)
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
FERNET_KEY=PASTE_YOUR_FERNET_KEY_HERE
JWT_SECRET_KEY=PASTE_YOUR_JWT_SECRET_KEY_HERE

# App settings (defaults match jarvis.core.config when unset)
API_PORT=8000
JWT_ALGORITHM=HS256
JWT_EXP_DELTA_SECONDS=3600
JARVIS_DEFAULT_MODEL=GPT_4O_MINI
JARVIS_LOCAL_THREAD_ID=1
JARVIS_IDENTIFICATION_FAILED_PROTOCOL=AUTOMATIC_RESPONSE
JARVIS_DB_DEBUG_MODE=0
JARVIS_USE_MCP=0
# Include tool call/result lines in chat UI/API history (default: final replies only)
JARVIS_SHOW_TOOL_TRACES=0

# LangSmith tracing (optional; inspect agent/tool runs without chat verbosity)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=PASTE_YOUR_LANGSMITH_API_KEY_HERE
# LANGSMITH_PROJECT=jarvis
