# Copy to deploy/pi.local.env (gitignored) and fill in for your LAN Pi.
# Used by deploy/sync_secrets.py and deploy/update_code.py

# SSH login on the Raspberry Pi
JARVIS_PI_USER=pi
JARVIS_PI_HOST=192.168.1.50

# Absolute path to the Jarvis git clone on the Pi
JARVIS_PI_DIR=/home/pi/jarvis

# Set to 1 if you installed the unit as a systemd --user service
# JARVIS_PI_SYSTEMD_USER=0
