# systemd unit for the Jarvis HTTP API on a Raspberry Pi.
# Install (system-wide example):
#   1. Edit User= and paths below for your Pi account and clone location.
#   2. sudo cp deploy/jarvis.service /etc/systemd/system/jarvis.service
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now jarvis.service
#   5. systemctl status jarvis.service
#
# Prefer a normal system service so the API starts at boot without a login.
# Keep JARVIS_EXPOSE_API_WITH_CLOUDFLARED=0 on the Pi (LAN-only; see docs).

[Unit]
Description=Jarvis HTTP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/jarvis
# Install uv with the official installer so this path exists, or adjust.
ExecStart=/home/pi/.local/bin/uv run --directory /home/pi/jarvis jarvis api
Restart=on-failure
RestartSec=5
# Do not expose a public quick tunnel from the Pi by default.
Environment=JARVIS_EXPOSE_API_WITH_CLOUDFLARED=0

[Install]
WantedBy=multi-user.target
